# Server-only: base URL of the FastAPI backend (no trailing slash).
# Read only by app/api/proxy — never exposed to the browser.
API_BASE_URL=http://localhost:8000
# Server-only: must match backend's .env API_KEY_NAME value.
API_KEY=your-api-key
# Server-only, last-resort safety net: how long the proxy waits for the
# backend's response headers before answering 504 (ms), for reads / writes
# (chat answers, uploads). Streams (SSE) are never cut off once headers arrive.
BACKEND_TIMEOUT_MS=60000
BACKEND_WRITE_TIMEOUT_MS=180000
# Retries (jittered backoff) of reads and sign-out after a connection error or
# a 502/503/504 from the backend. 0 disables.
BACKEND_RETRIES=2

# --- SSO / sessions (planchanges4 B2, F1) ---
# Public URL of this frontend; the Entra redirect URI is APP_BASE_URL + /auth/callback.
APP_BASE_URL=http://localhost:3000
# Must match the backend's SESSION_COOKIE_NAME / SESSION_COOKIE_SECURE.
SESSION_COOKIE_NAME=askdiq_session
# true when served over HTTPS (production).
SESSION_COOKIE_SECURE=false
# Shown on the login and suspended pages (before a session exists); keep equal
# to the backend's ACCESS_CONTACT_EMAIL. Empty = "contact your administrator".
ACCESS_CONTACT_EMAIL=
# Development only: forward /mock-idp/* to the backend's mock Entra IdP
# (backend AUTH_DEV_MOCK=true, ENV=development). Never true in production.
AUTH_DEV_MOCK=false
