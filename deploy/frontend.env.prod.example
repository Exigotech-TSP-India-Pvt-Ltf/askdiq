# /opt/askdiq/frontend/.env  (askdiq-web runtime settings; server-only)
# Create on the server:  cp deploy-kit/deploy/frontend.env.prod.example /opt/askdiq/frontend/.env
# then fill in the values. Never commit or ship the real file.
# All of these are read per request at run time; none is baked into the image.

# FastAPI backend, by container name on the askdiq_internal network.
API_BASE_URL=http://askdiq-api:8000
# Must equal API_KEY_NAME in /opt/askdiq/backend/.env.
API_KEY=<same value as backend API_KEY_NAME>

# Public origin of the dashboard. Must equal the backend's APP_BASE_URL.
APP_BASE_URL=https://askdiq-admin.ethub.co

# Must match the backend's SESSION_COOKIE_NAME / SESSION_COOKIE_SECURE.
SESSION_COOKIE_NAME=askdiq_session
# true over HTTPS: the session cookie is then Secure; it is always HttpOnly,
# SameSite=Lax, Path=/.
SESSION_COOKIE_SECURE=true

# Shown on the login / suspended pages; keep equal to the backend's value.
ACCESS_CONTACT_EMAIL=

# Development-only mock IdP forwarding. Must stay false in production.
AUTH_DEV_MOCK=false
