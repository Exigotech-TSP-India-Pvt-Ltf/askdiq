# Production image for askdiq-api (DeployIQ RAG backend).
# Build context: ./backend. Deployment runbook: docs/deployment/runbook.md.
FROM python:3.14-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# gcc/libpq-dev: build deps for wheels (e.g. cffi/cryptography) without prebuilt
# wheels for this Python version; curl: used by the HEALTHCHECK below.
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# The knowledge-base sources must be in the image for the entrypoint's
# ingestion step (.dockerignore re-includes data/real_docs/*.md); fail the
# build if they are missing. The sed strips CRLF in case the entrypoint was
# checked out on Windows.
RUN test -f data/real_docs/deploy-iq-platform.md \
    && sed -i 's/\r$//' docker-entrypoint.sh \
    && useradd --create-home --uid 1000 --shell /usr/sbin/nologin appuser \
    && chown -R appuser:appuser /app
USER appuser

# Start-up automation (docker-entrypoint.sh -> scripts/prestart.py), API only:
# migrations under a Postgres advisory lock (fatal on error), then idempotent
# knowledge-base ingestion (non-fatal). The usage backfill is opt-in.
ENV RUN_MIGRATIONS=true \
    RUN_INGESTION=true \
    RUN_USAGE_BACKFILL=false

EXPOSE 8000

# start-period covers the entrypoint's migrations + ingestion before uvicorn.
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# main.py (at backend/ root) defines `app` -> module path "main:app".
# Multiple workers are safe: rate limits, OIDC state, the job queue and event
# fan-out are shared through Postgres (planchanges4 B1.4), and a request's
# post-answer writes stay inside the one process that served it.
# WEB_CONCURRENCY sets the worker count (infra/scale-out/docker-compose.yml sets 2 per
# replica); size the DB pool with the rule in docs/deployment/docker-and-auth-contract.md. Shell form so the
# variable expands; `exec` keeps uvicorn as PID 1 to receive SIGTERM.
# The entrypoint runs the pre-start steps only for a uvicorn command, then
# `exec`s CMD unchanged; other commands (the job worker) are exec'd directly.
ENTRYPOINT ["sh", "/app/docker-entrypoint.sh"]
CMD ["sh", "-c", "exec uvicorn main:app --host 0.0.0.0 --port 8000 --workers ${WEB_CONCURRENCY:-1} --timeout-graceful-shutdown 20"]
