# Production image for askdiq-api (DeployIQ RAG backend).
# Build context: ./backend
FROM python:3.14-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# gcc/libpq-dev: build deps for wheels (e.g. cffi/cryptography) without prebuilt
# wheels for this Python version; curl: used by the HEALTHCHECK below.
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# main.py (at backend/ root) defines `app` -> module path "main:app".
# Multiple workers are safe: rate limits, OIDC state, the job queue and event
# fan-out are shared through Postgres (planchanges4 B1.4), and a request's
# post-answer writes stay inside the one process that served it.
# WEB_CONCURRENCY sets the worker count (docker-compose.prod.yml sets 2 per
# replica); size the DB pool with the rule in DEPLOYMENT.md. Shell form so the
# variable expands; `exec` keeps uvicorn as PID 1 to receive SIGTERM.
CMD ["sh", "-c", "exec uvicorn main:app --host 0.0.0.0 --port 8000 --workers ${WEB_CONCURRENCY:-1}"]
