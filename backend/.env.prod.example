# Production environment template for askdiq-api.
# Copy to backend/.env on the production host and fill in real values —
# never commit the real .env.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
# Proxy-to-backend service key; must equal the frontend's API_KEY.
API_KEY_NAME=CHANGE_ME_GENERATE_SECURE_API_KEY
# At least 32 bytes: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=CHANGE_ME_generate_with_python_-c_"import secrets; print(secrets.token_hex(32))"
ENTRA_TENANT_ID=your-entra-tenant-id
ENTRA_CLIENT_ID=your-entra-app-client-id
ENTRA_CLIENT_SECRET=your-entra-app-client-secret
ENTRA_REDIRECT_URI=https://app.your-domain.com/auth/callback
APP_BASE_URL=https://app.your-domain.com
SESSION_COOKIE_SECURE=true
SUPERADMIN_EMAILS=
ACCESS_CONTACT_EMAIL=
AUTH_DEV_MOCK=false
ENV=production
LOG_LEVEL=info
TRUST_PROXY_HEADERS=true
CORS_ALLOWED_ORIGINS=["https://app.your-domain.com"]
AZURE_OPENAI_API_KEY=YOUR_AZURE_KEY
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_DEPLOYMENT_NAME=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

