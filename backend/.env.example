# Database
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5433/ragdb

# LLM + Embeddings 
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.services.ai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_TEMPERATURE=1.0
AZURE_OPENAI_CREATIVE_TEMPERATURE=1.0
AZURE_OPENAI_REQUEST_TIMEOUT=60.0
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Auth
# Generate a strong random secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
API_JWT_SECRET=your-random-jwt-signing-secret
API_JWT_ALGORITHM=HS256
# Required in the X-API-Key header on every request (Swagger UI "Authorize" / Postman).
API_KEY_NAME=

# Guardrails
GROUNDEDNESS_THRESHOLD=0.55
MAX_QUERY_LENGTH=2000

# Retrieval
# Chunks retrieved per query — fixed server-side, not a client request parameter.
DEFAULT_TOP_K=5

# App
ENV=development
LOG_LEVEL=info
