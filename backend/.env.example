# Database
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5433/ragdb

# --- Testing ---
# Dedicated database for the automated test suite, so tests never touch the
# app database. Use a separate DB on the same server; the role needs CREATEDB.
# Parallel PR workers derive their own DB from it by appending TEST_DB_SUFFIX
# (e.g. ragdb_test_pr06), set per command, never stored here.
TEST_DATABASE_URL=postgresql+asyncpg://askdiq_test:CHANGE_ME@localhost:5433/ragdb_test
TEST_DB_SUFFIX=

# LLM + Embeddings 
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.services.ai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_TEMPERATURE=1.0
AZURE_OPENAI_REQUEST_TIMEOUT=60.0
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Auth
# Service key between the Next.js proxy and this API (X-API-Key header).
# After SSO it no longer grants user access on its own. Must equal frontend API_KEY.
API_KEY_NAME=

# --- SSO: Microsoft Entra ID (OIDC) ---
# The generic names used by other Exigo apps also work: OIDC_CLIENT_ID, OIDC_CLIENT_SECRET,
# OIDC_REDIRECT_URI, OIDC_DISCOVERY_URL (tenant read from it; ENTRA_TENANT_ID then optional).
# If both an ENTRA_* and an OIDC_* name are set, the ENTRA_* value wins.
# To reuse an Entra registration made for a NextAuth app, use its redirect URI exactly, e.g.
# OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback/microsoft-entra-id (served by the frontend).
# Single-tenant app registration. Redirect URI registered in Entra must equal
# ENTRA_REDIRECT_URI exactly (port 3000). Verify with: scripts/verify_sso_config.py
# Production values (askdiqui.ethub.co): docs/deployment/environment-and-sso.md
ENTRA_TENANT_ID=your-entra-tenant-id
ENTRA_CLIENT_ID=your-entra-app-client-id
ENTRA_CLIENT_SECRET=your-entra-app-client-secret
ENTRA_REDIRECT_URI=http://localhost:3000/auth/callback
APP_BASE_URL=http://localhost:3000
# Authority host for real Entra (sovereign clouds differ); normally leave as is.
ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com
# Local-only mock identity provider. The app refuses to start if true and ENV is not development.
# With it on, ENTRA_* may stay unset (placeholder ids are used).
AUTH_DEV_MOCK=false
# Mock IdP base URL; empty = APP_BASE_URL + /mock-idp.
AUTH_MOCK_BASE_URL=
# Optional explicit discovery document URL (real Entra only; ignored when AUTH_DEV_MOCK=true).
# Empty = built from ENTRA_AUTHORITY_HOST + ENTRA_TENANT_ID. Must be https and for the same tenant.
OIDC_DISCOVERY_URL=https://login.microsoftonline.com/your-entra-tenant-id/v2.0/.well-known/openid-configuration
# OIDC client tuning.
OIDC_HTTP_TIMEOUT_SECONDS=10
OIDC_STATE_TTL_SECONDS=600
OIDC_METADATA_CACHE_SECONDS=3600
OIDC_CLOCK_SKEW_SECONDS=60
# Per-client-IP cap on the sign-in endpoints (/auth/sso/login and /auth/sso/callback).
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- Sessions ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=your-random-session-signing-secret
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=60
# last_seen_at is written at most this often per session.
SESSION_TOUCH_INTERVAL_SECONDS=60
# Must match frontend SESSION_COOKIE_NAME / SESSION_COOKIE_SECURE.
SESSION_COOKIE_NAME=askdiq_session
SESSION_COOKIE_SECURE=false
# Chat sessions returned by GET /sessions (most recent first).
SESSION_LIST_MAX_ITEMS=200

# --- Access control ---
# Comma-separated emails that become active superadmins on first SSO login.
SUPERADMIN_EMAILS=
# Admin contact shown on the Access Required / suspended pages.
ACCESS_CONTACT_EMAIL=

# Guardrails
GROUNDEDNESS_THRESHOLD=0.45
# Multi-sentence answers: share (0-1) of sentences/bullets that must be supported by a source chunk.
GROUNDEDNESS_MIN_SUPPORTED_RATIO=0.5
# Lexical containment: share of a claim's words in one chunk (figures/names must all occur) that counts as supported.
GROUNDEDNESS_LEXICAL_MIN=0.7
# Citation verification (a [n] marker is kept only if the cited chunk really contains the claim)
CITATION_MIN_OVERLAP=0.5
CITATION_MIN_COSINE=0.45
# Off-topic rule (0-1): best retrieval score below this AND no query word in any chunk -> off-topic.
OFFTOPIC_OVERLAP_MAX_SCORE=0.30
MAX_QUERY_LENGTH=2000

# Retrieval
# Chunks retrieved per query — fixed server-side, not a client request parameter.
DEFAULT_TOP_K=5

# Response style (OR-8): "adaptive" structures answers by question type
# (definition, how-to, comparison, quick fact, partial, out of scope);
# "current" is the original prompt (off switch). A/B: RESPONSE_STYLE_B goes to
# RESPONSE_STYLE_B_PCT% of sessions (0-100, sticky per session).
RESPONSE_STYLE=adaptive
RESPONSE_STYLE_B=current
RESPONSE_STYLE_B_PCT=0
ANSWER_MAX_WORDS_LONG=220

# Clarifying questions: a short question whose evidence spans several topics
# with similar scores may get 2-4 options (document titles/sections) instead
# of a guessed answer. The LLM confirms; at most N clarifications in a row.
CLARIFY_ENABLED=true
CLARIFY_MAX_CONSECUTIVE=2
CLARIFY_MAX_QUERY_WORDS=4
CLARIFY_SCORE_MARGIN=0.06
CLARIFY_MIN_OPTIONS=2
CLARIFY_MAX_OPTIONS=4
# Questions asked at once (the model picks 1..N as needed).
CLARIFY_MAX_QUESTIONS=4
# Tag one option "Recommended" when its retrieval score leads the runner-up by the margin.
CLARIFY_RECOMMEND_ENABLED=true
CLARIFY_RECOMMEND_MARGIN=0.05
# Rule-detected ambiguity (vague referent, underspecified compliance request)
# asks before the low-confidence fallback when the best score reaches this floor.
CLARIFY_MIN_RETRIEVAL_SCORE=0.12
# Minimum best retrieval score (0-1) before any clarification is offered; below it, options would be guesses.
CLARIFY_MIN_GATE_SCORE=0.30
# Cheap LLM confirmation for borderline underspecified requests (seconds/tokens).
CLARIFY_DECISION_TIMEOUT_SECONDS=3.0
CLARIFY_DECISION_MAX_TOKENS=400
# Wider retrieval for short questions that may need clarifying.
CLARIFY_RETRIEVAL_TOP_K=10
CLARIFY_RETRIEVAL_MAX_DOCUMENTS=6

# App
ENV=development
LOG_LEVEL=info
DEV_TEST_IPS=127.0.0.1,::1,localhost,0.0.0.0
TRUST_PROXY_HEADERS=false
# true when a trusted server-side caller (the website frontend, holding the API key)
# forwards the real end user's IP in the /query body `ip_address`. Only valid IPs are used.
ALLOW_CLIENT_IP_OVERRIDE=false
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Feature Rollout Flags
INGEST_SERVER_CONVERSION=true
ONLINE_EVAL_ENABLED=false
ONLINE_EVAL_SAMPLE_RATE=0.10

# Branding & White-Labelling
BRAND_NAME=DeployIQ
BRAND_ASSISTANT_NAME=AskDIQ
BRAND_SUPPORT_EMAIL=support@deployiq.com
BRAND_COMPANY_NAME=Exigo Tech
# The brand_settings DB row (Settings > Branding) overrides the values above.
BRANDING_CACHE_TTL_SECONDS=60
# Upper bound on one branding DB read; on timeout the config defaults are served.
BRANDING_LOAD_TIMEOUT_SECONDS=5
BRANDING_HTTP_MAX_AGE_SECONDS=300
BRANDING_ASSET_MAX_BYTES=524288
BRANDING_ASSET_MAX_DIMENSION=4096

# Token Pricing (USD per 1M tokens). Defaults: a superadmin can override these,
# AZURE_DEPLOYMENT_NAME and EMBEDDING_MODEL at runtime in Settings > Models.
PRICE_EMBED_PER_MILLION=0.02
PRICE_PROMPT_PER_MILLION=0.25
PRICE_OUTPUT_PER_MILLION=2.00
PRICE_CACHED_PER_MILLION=0.025
# How often each worker re-reads the Settings > Models overrides (seconds).
MODEL_SETTINGS_REFRESH_SECONDS=60
MODEL_SETTINGS_LOAD_TIMEOUT_SECONDS=5

# Audience & Usage Analytics Settings
AUDIENCE_CACHE_TTL_SECONDS=30
USAGE_SUMMARY_CACHE_TTL_SECONDS=15
# Dashboard aggregates (analytics, usage, governance, visitors): fresh for FRESH s,
# then served instantly while one background task recomputes them, up to STALE s.
# FRESH=0 disables this cache.
DASHBOARD_CACHE_FRESH_SECONDS=15
DASHBOARD_CACHE_STALE_SECONDS=600
# Precomputed dashboard aggregates (table dashboard_snapshots), kept fresh by the
# jobs worker: every REFRESH s (0 = off) the watched ones follow new data, all of
# them catch up at least every IDLE_REFRESH s; a read older than MAX_AGE refreshes
# in the background; unused ones are dropped after KEEP_HOURS.
DASHBOARD_SNAPSHOT_REFRESH_SECONDS=30
DASHBOARD_SNAPSHOT_IDLE_REFRESH_SECONDS=900
DASHBOARD_SNAPSHOT_MAX_AGE_SECONDS=1800
DASHBOARD_SNAPSHOT_KEEP_HOURS=168
# false = in-process cache only (no dashboard_snapshots table reads / writes).
DASHBOARD_SNAPSHOTS_PERSIST=true
# Real time: data / alerts stamp check (s, 0 = off), minimum gap between
# change-triggered snapshot refreshes (s), and the console live stream's
# coalescing window (s; GET /admin/live).
DASHBOARD_WATCH_SECONDS=2
DASHBOARD_MIN_CHANGE_REFRESH_SECONDS=3
CONSOLE_STREAM_COALESCE_SECONDS=0.5
USAGE_PAGE_MAX_LIMIT=200
USAGE_MAX_OFFSET=10000
USAGE_EXPORT_MAX_ROWS=10000
USAGE_MAX_RANGE_DAYS=400
USAGE_AGG_MAX_CONCURRENCY=4
# Optional monthly spend budget in USD (dashboard cost bullet); unset = no budget.
# MONTHLY_COST_BUDGET_USD=250
TEST_IP_MAX_ENTRIES=500

# Quotas & Limits (Verified from live Azure headers)
AZURE_OPENAI_TPM_LIMIT=1000000
AZURE_OPENAI_RPM_LIMIT=1000
INGEST_MAX_FILE_BYTES=10485760

# --- Platform: concurrency & performance ---
# Target: >= 50 concurrent requests. Keep
# replicas x WEB_CONCURRENCY x (DB_POOL_SIZE + DB_MAX_OVERFLOW) <= Postgres max_connections - 20.
# Single process today: keep the pool at 20 + 10. When you raise WEB_CONCURRENCY
# or add replicas, lower the per-process pool to stay within max_connections.
WEB_CONCURRENCY=1
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
# Last-resort wait for a free pooled connection (s); bursts queue, not fail.
DB_POOL_TIMEOUT_SECONDS=120
DB_POOL_PRE_PING=true
# Postgres ends a session idle in a transaction this long (ms; 0 = off).
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# Per-statement cap (ms; 0 = off) for API request sessions: a query stuck
# behind a lock is cancelled and the request gets 503 code=db_timeout instead
# of hanging. Dashboards keep the stricter DASHBOARD_STATEMENT_TIMEOUT_MS.
# Not applied to jobs/schedulers/ingestion scripts; exports and ingest
# endpoints opt out (database.unbounded_session).
DB_STATEMENT_TIMEOUT_MS=15000
DASHBOARD_STATEMENT_TIMEOUT_MS=5000
# Alembic online migrations: wait at most this long (ms) for a table lock
# (so an ALTER never queues every API query behind it), then retry the whole
# upgrade up to MIGRATION_LOCK_RETRIES times, backoff doubling from
# MIGRATION_LOCK_RETRY_BACKOFF_SECONDS (capped at 60 s). Statement timeout
# for migrations: 0 = unlimited (long data migrations).
# (MIGRATION_LOCK_TIMEOUT_SECONDS, read by scripts/prestart.py, is the
# separate wait for the replica advisory lock / upgrade subprocess.)
MIGRATION_LOCK_TIMEOUT_MS=5000
MIGRATION_STATEMENT_TIMEOUT_MS=0
MIGRATION_LOCK_RETRIES=5
MIGRATION_LOCK_RETRY_BACKOFF_SECONDS=2
OUTBOUND_TIMEOUT_SECONDS=30
LLM_MAX_CONCURRENCY=64
ONLINE_EVAL_MAX_CONCURRENCY=4
# Evaluations waiting for a slot; beyond this new ones are skipped (logged).
ONLINE_EVAL_MAX_PENDING=200
# Docs (/docs, /openapi.json) are disabled when ENV=production unless this is true.
ENABLE_API_DOCS=false

# --- Platform: security & resilience (PR-03) ---
# ENABLE_API_DOCS and OUTBOUND_TIMEOUT_SECONDS are documented in the block above.
# Chat-completion clients keep AZURE_OPENAI_REQUEST_TIMEOUT as their timeout.
# Response security headers (HSTS is only sent when ENV=production).
SECURITY_CSP="default-src 'none'; frame-ancestors 'none'"
SECURITY_HSTS="max-age=63072000; includeSubDomains"
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=()"
SECURITY_COOP=same-origin
SECURITY_FRAME_OPTIONS=DENY
# Explicit CORS allow-lists (JSON arrays, no wildcards).
CORS_ALLOW_HEADERS=["Content-Type","X-API-Key","X-Request-ID","X-Client-Id","If-None-Match"]
CORS_ALLOW_METHODS=["GET","POST","PATCH","DELETE","OPTIONS"]
# LLM circuit breaker: open after N transient failures within the window,
# then allow one half-open probe after the reset timeout.
LLM_BREAKER_FAILURE_THRESHOLD=5
LLM_BREAKER_WINDOW_SECONDS=60
LLM_BREAKER_RESET_SECONDS=30
# Max seconds shutdown waits for in-flight background tasks.
TASK_DRAIN_TIMEOUT_SECONDS=10

# --- Background jobs (Postgres SKIP LOCKED queue) ---
JOBS_WORKER_ENABLED=true
JOBS_MAX_CONCURRENCY=4
JOBS_LOCK_TIMEOUT_SECONDS=300

# --- Platform: jobs, shared state & HTTP (PR-04) ---
# Shared state backend: auto (memory when ENV=test, else postgres) | memory | postgres.
STATE_BACKEND=auto
# JSON list of actors exempt from the per-user /query limit (load tests only).
RATE_LIMIT_EXEMPT_ACTORS=[]
DB_POOL_RECYCLE_SECONDS=1800
LLM_SATURATED_RETRY_AFTER_SECONDS=2
AGG_MAX_CONCURRENCY=4
# Pool connections parallel aggregation can never take (kept for plain requests).
AGG_POOL_RESERVE=5
EVENTS_CHANNEL=askdiq_events
EVENTS_RECONNECT_MAX_SECONDS=30
GZIP_MINIMUM_SIZE=1024
HTTP_CACHE_MAX_AGE_SECONDS=0
SSE_HEARTBEAT_SECONDS=15
# Each live stream ends after this many seconds and the browser reconnects, so streams never block a reload.
SSE_MAX_STREAM_SECONDS=120
SSE_RETRY_MS=3000
JOBS_POLL_INTERVAL_SECONDS=1.0
JOBS_MAX_ATTEMPTS=5
JOBS_BACKOFF_BASE_SECONDS=2.0
JOBS_BACKOFF_MAX_SECONDS=600
JOBS_SHUTDOWN_TIMEOUT_SECONDS=30
JOBS_RETENTION_DAYS=7
STATE_CLEANUP_INTERVAL_SECONDS=60
# "Run full evaluation" (Evaluation page): cases in flight, hard time limit
# per run, progress update cadence and starts per admin per minute.
EVAL_RUN_CONCURRENCY=2
EVAL_RUN_TIMEOUT_SECONDS=7200
EVAL_RUN_PROGRESS_SECONDS=2.0
EVAL_RUN_RATE_LIMIT_PER_MINUTE=3

# --- Feedback / RLHF loop (PR-11) ---
FEEDBACK_TREND_DAYS=30
FEEDBACK_GAP_CONFIDENCE_THRESHOLD=0.5
FEEDBACK_GAP_LIMIT=10
FEEDBACK_EXPORT_BATCH_SIZE=500
# --- Governance endpoints & live stream (PR-10) ---
# Above this many matching rows, list totals become planner estimates.
GOVERNANCE_EXACT_COUNT_CAP=100000
GOVERNANCE_EXPORT_MAX_ROWS=100000
# Upper bounds (ms) of the fast / moderate / slow trace latency buckets.
GOVERNANCE_LATENCY_BUCKETS_MS=[1000,3000,10000]
# Health status (Healthy / Degraded / Incident): value >= threshold.
GOVERNANCE_HEALTH_WINDOW_MINUTES=60
GOVERNANCE_HEALTH_ERROR_RATE_DEGRADED_PCT=2.0
GOVERNANCE_HEALTH_ERROR_RATE_INCIDENT_PCT=10.0
GOVERNANCE_HEALTH_P95_DEGRADED_MS=8000
GOVERNANCE_HEALTH_P95_INCIDENT_MS=20000
GOVERNANCE_HEALTH_QUOTA_DEGRADED_PCT=80
GOVERNANCE_HEALTH_QUOTA_INCIDENT_PCT=95
GOVERNANCE_INCIDENTS_WINDOW_HOURS=24
GOVERNANCE_INCIDENTS_LIMIT=10
# SSE producer tick (one shared producer per worker and audience).
GOVERNANCE_STREAM_INTERVAL_SECONDS=5
# Upper bound on one producer snapshot (its DB sessions are always returned).
GOVERNANCE_STREAM_SNAPSHOT_TIMEOUT_SECONDS=60
GOVERNANCE_QUOTA_SAMPLE_SECONDS=60
GOVERNANCE_QUOTA_SERIES_POINTS=60

# --- Insights / Analytics classifier ---
INSIGHTS_BATCH_SIZE=10
INSIGHTS_DAILY_TOKEN_BUDGET=200000
INSIGHTS_TIMEZONE=Australia/Sydney
# Enqueue insights.classify after each persisted assistant message.
INSIGHTS_CLASSIFY_ON_WRITE=true
# Text sent to the classifier is PII-masked, then truncated to these lengths.
INSIGHTS_USER_MAX_CHARS=1000
INSIGHTS_ANSWER_MAX_CHARS=600
# Empty = AZURE_DEPLOYMENT_NAME.
INSIGHTS_MODEL=
INSIGHTS_REASONING_EFFORT=minimal
INSIGHTS_COMPLETION_TOKENS_PER_TURN=120

# --- Dashboard ---
MONTHLY_COST_BUDGET_USD=100


# --- Resource telemetry (Governance > Monitoring gauges, live stream) ---
# Every API worker samples host / container (cgroup) / process metrics, event-
# loop lag and DB pool use; the stream pushes the aggregate at the same pace.
METRICS_ENABLED=true
METRICS_SAMPLE_INTERVAL_SECONDS=5
METRICS_HISTORY_MINUTES=15
METRICS_WORKER_STALE_INTERVALS=3

# --- Alerts (app/alerts; catalogue: GET /admin/alerts/rules) ---
# Rules run in the job worker (JOBS_WORKER_ENABLED); alerts are stored and
# shown in the admin console bell. Email is sent only when SMTP_HOST,
# ALERT_EMAIL_FROM and ALERT_EMAIL_TO are all set.
ALERTS_ENABLED=true
ALERTS_EVALUATE_INTERVAL_SECONDS=30
ALERTS_SAMPLE_INTERVAL_SECONDS=30
ALERTS_LOCAL_RESOLVE_MINUTES=5
# The same alert is not emailed again within this many minutes.
ALERT_COOLDOWN_MINUTES=60
ALERT_RETENTION_DAYS=90
# info | warning | critical
ALERT_EMAIL_MIN_SEVERITY=info
ALERT_EMAIL_MAX_ATTEMPTS=5
ALERT_NOTIFY_RESOLVED=true
ALERT_TIMEZONE=Australia/Sydney
# Thresholds (error rate / p95 / quota reuse GOVERNANCE_HEALTH_*).
ALERT_MIN_REQUESTS=20
ALERT_LATENCY_MIN_SAMPLES=10
ALERT_LLM_FAILURE_WINDOW_MINUTES=15
ALERT_LLM_FAILURES_THRESHOLD=5
ALERT_AZURE_429_THRESHOLD=3
# Azure-side 429s (Monitor metrics, all callers) in the last N minutes.
ALERT_AZURE_MONITOR_429_THRESHOLD=10
ALERT_AZURE_MONITOR_429_WINDOW_MINUTES=15
ALERT_BUDGET_WARNING_PCT=80
ALERT_BUDGET_CRITICAL_PCT=100
ALERT_FEEDBACK_WINDOW_MINUTES=60
ALERT_FEEDBACK_MIN_RATINGS=5
ALERT_FEEDBACK_NEGATIVE_PCT=25
ALERT_FAILURE_WINDOW_MINUTES=60
ALERT_ONLINE_EVAL_VIOLATIONS_THRESHOLD=3
ALERT_EVENT_BUS_GRACE_SECONDS=60
# Resource rules (CPU / memory: container when limited, else server). The
# condition must hold for the whole sustain window; one spike never alerts.
ALERT_RESOURCE_SUSTAIN_SECONDS=120
ALERT_CPU_WARNING_PCT=80
ALERT_CPU_CRITICAL_PCT=95
ALERT_MEMORY_WARNING_PCT=85
ALERT_MEMORY_CRITICAL_PCT=95
ALERT_LOOP_LAG_WARNING_MS=200
ALERT_LOOP_LAG_CRITICAL_MS=1000
ALERT_DB_POOL_SATURATION_PCT=90
# Leak heuristic: a worker RSS rising (almost) every sample by this much.
ALERT_RSS_GROWTH_MB=256
ALERT_RSS_GROWTH_MIN_SAMPLES=24
# Azure Insights rules (only while AZURE_INSIGHTS_ENABLED): quota near the
# Azure-reported TPM/RPM (peak 1-min usage over the window) or regional quota
# currentValue/limit at or above this %, and a source failing this many runs.
ALERT_AZURE_QUOTA_PCT=85
ALERT_AZURE_QUOTA_WINDOW_MINUTES=15
ALERT_AZURE_SYNC_FAILURES=3
# SMTP: STARTTLS on 587 (default) or SMTP_SSL=true for implicit TLS on 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=15
# Sender ("Name <address>" or address) and comma-separated recipients.
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Links in alert emails point at APP_BASE_URL (the admin console).

# --- Azure Insights (free Foundry / Azure data in the admin console) ---
# Off by default: nothing is polled and the console shows "Not connected".
# Setup (all free, read-only roles): foundry-usage-data-review.md "How to enable".
# Use a SEPARATE app registration from ENTRA_* (sign-in). When enabled every
# id below is required. Never commit real values.
AZURE_INSIGHTS_ENABLED=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_OPENAI_RESOURCE_NAME=
# ARM region of the resource, e.g. australiaeast.
AZURE_OPENAI_REGION=
# Retail prices (public, works even when disabled): USD + this currency.
AZURE_PRICING_CURRENCY=AUD
# Global | DataZone | Regional (picks the retail meter family).
AZURE_DEPLOYMENT_TYPE=Global
AZURE_RETAIL_FALLBACK_REGION=eastus2
AZURE_RETAIL_LLM_MODEL=gpt-5-mini
AZURE_RETAIL_EMBEDDING_MODEL=text-embedding-3-small
AZURE_RETAIL_SYNC_RATE_LIMIT_PER_MINUTE=5
# Poll intervals (seconds). Results are stored with their history.
AZURE_METRICS_INTERVAL_SECONDS=900
AZURE_COSTS_INTERVAL_SECONDS=86400
AZURE_CAPACITY_INTERVAL_SECONDS=21600
AZURE_HEALTH_INTERVAL_SECONDS=600
AZURE_SERVICE_HEALTH_INTERVAL_SECONDS=1800
AZURE_RETAIL_INTERVAL_SECONDS=604800
# Hard monthly stop for metrics calls (10% of the 1M free calls).
AZURE_METRICS_MONTHLY_CALL_CAP=100000
# Need subscription-scope read (optional roles).
AZURE_SERVICE_HEALTH_ENABLED=false
AZURE_ADVISOR_ENABLED=false
# Advisor recommendations poll (seconds, min 6 h; never generates new ones).
AZURE_ADVISOR_INTERVAL_SECONDS=86400
AZURE_HTTP_TIMEOUT_SECONDS=30
# Azure vs AskDIQ reconciliation: highlight drift at or above this %.
AZURE_RECONCILIATION_DRIFT_PCT=10
# Billed cost (Cost Management Query, needs Cost Management Reader): polled
# once a day at this local time (INSIGHTS_TIMEZONE); Azure lags 8-72 h.
AZURE_COSTS_RUN_AT=03:00
AZURE_COSTS_API_VERSION=2026-06-01
# Billed-cost history kept (days, at least 400).
AZURE_COSTS_RETENTION_DAYS=400
# Monthly Azure budget in the BILLING currency (e.g. AUD) for the
# azure_billed_budget alert; a USD bill uses MONTHLY_COST_BUDGET_USD instead.
# Thresholds: ALERT_BUDGET_WARNING_PCT / ALERT_BUDGET_CRITICAL_PCT.
# AZURE_MONTHLY_BUDGET=150
# azure_estimate_drift: closed day where |billed - estimate| / billed > PCT
# and billed >= MIN (billing currency).
ALERT_AZURE_DRIFT_PCT=15
ALERT_AZURE_DRIFT_MIN=1.0
