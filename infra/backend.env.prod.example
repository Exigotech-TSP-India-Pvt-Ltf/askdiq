# /opt/askdiq/backend/.env  (askdiq-api production settings)
# Template only: edit the server file in place, one line at a time, after a
# backup. Never commit or upload the real file.
# Every value is explained in docs/deployment/environment-and-sso.md;
# every other (optional) setting is listed in backend/.env.example.

ENV=production
LOG_LEVEL=info

# The shared Postgres (with pgvector). Never localhost inside a container.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@et-platform-postgres-1:5432/askdiq

# Azure OpenAI. The two deployment names are defaults: a superadmin can
# override them (and the PRICE_* rates) in Settings > Models & Pricing.
AZURE_OPENAI_API_KEY=YOUR_AZURE_KEY
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_DEPLOYMENT_NAME=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Service key used by the public website and by the console's server-side proxy
# (X-API-Key). Keep the existing value on the server; must equal the
# frontend's API_KEY. New install: openssl rand -hex 32
API_KEY_NAME=CHANGE_ME
# At least 32 bytes in production: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME

# Microsoft Entra ID (single-tenant app registration, Web platform).
ENTRA_TENANT_ID=your-entra-tenant-id
ENTRA_CLIENT_ID=your-entra-app-client-id
ENTRA_CLIENT_SECRET=your-entra-client-secret-value
# Must equal a Web redirect URI registered in Entra, byte for byte.
ENTRA_REDIRECT_URI=https://askdiqui.ethub.co/api/auth/callback/microsoft-entra-id

# Admin console origin (no trailing slash); must equal the frontend's APP_BASE_URL.
APP_BASE_URL=https://askdiqui.ethub.co
SESSION_COOKIE_NAME=askdiq_session
SESSION_COOKIE_SECURE=true
TRUST_PROXY_HEADERS=true
AUTH_DEV_MOCK=false

# Comma-separated emails that become active superadmins when they sign in.
SUPERADMIN_EMAILS=
ACCESS_CONTACT_EMAIL=

# true while the public website forwards the visitor IP in the /query body.
ALLOW_CLIENT_IP_OVERRIDE=true
# Only browsers that call https://askdiq.ethub.co directly need an entry; the
# console needs none. Keep the server's current value.
CORS_ALLOWED_ORIGINS=[]
